+QVariantList BarlineSettingsModel::playbackRangesForUi() const
+{
+    QVariantList result;
+    
+    FILE* f = fopen("C:/msbuild/debug_ranges.txt", "a");
+    if (f) { fprintf(f, "called, size=%zu\n", m_elementList.size()); fclose(f); }
+
+    for (EngravingItem* item : m_elementList) {
+        if (!item->isBarLine()) {
+            continue;
+        }
+        BarLine* bl = toBarLine(item);
+        Measure* measure = bl->measure();
+        if (!measure) {
+            continue;
+        }
+        for (const PlaybackRange& range : measure->playbackRanges()) {
+            QVariantMap rangeMap;
+            rangeMap["startTick"] = range.startTick.ticks();
+            rangeMap["endTick"] = range.endTick.ticks();
+
+            QVariantList velocities;
+            for (const auto& [count, velo] : range.velocities) {
+                QVariantMap v;
+                v["playbackCount"] = count;
+                v["velocity"] = velo;
+                velocities << v;
+            }
+            rangeMap["velocities"] = velocities;
+            result << rangeMap;
+        }
+    }
+    return result;
+}
+
+void BarlineSettingsModel::setPlaybackRangesFromUi(const QVariantList& ranges)
+{
+    undoStack()->prepareChanges(muse::TranslatableString("undoableAction", "Change playback ranges"));
+
+    for (EngravingItem* item : m_elementList) {
+        if (!item->isBarLine()) {
+            continue;
+        }
+        BarLine* bl = toBarLine(item);
+        Measure* measure = bl->measure();
+        if (!measure) {
+            continue;
+        }
+
+        String s;
+        for (const QVariant& rv : ranges) {
+            QVariantMap rangeMap = rv.toMap();
+            if (!s.empty()) {
+                s += u";";
+            }
+            s += String::number(rangeMap["startTick"].toInt()) + u"-"
+                + String::number(rangeMap["endTick"].toInt()) + u":";
+            bool first = true;
+            for (const QVariant& vv : rangeMap["velocities"].toList()) {
+                QVariantMap v = vv.toMap();
+                if (!first) {
+                    s += u",";
+                }
+                first = false;
+                s += String::number(v["playbackCount"].toInt()) + u"="
+                    + String::number(v["velocity"].toInt());
+            }
+        }
+
+        measure->undoChangeProperty(Pid::PLAYBACK_RANGES, PropertyValue(s));
+        FILE* f = fopen("C:/msbuild/debug_undo.txt", "a");
+        if (f) { fprintf(f, "PLAYBACK_RANGES changed: %s\n", s.toStdString().c_str()); fclose(f); }
+        break;
+    }
+
+    undoStack()->commitChanges();
+    updateNotation();
+}
